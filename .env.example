# Copy to .env and adjust. docker compose reads this file automatically.
STAGE=development

# Database
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=askbot
MYSQL_PASSWORD=askbot
MYSQL_DB=askbot
MYSQL_ROOT_PASSWORD=root

# Public base URL of the site (no trailing slash)
BASE_URL=http://localhost:8080

# Session / token signing secret - CHANGE THIS
APP_SECRET=change-me-please-32-random-chars

# Mail (SMTP). The dev stack ships Mailpit on http://localhost:8025
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_SECURITY=
MAIL_FROM=noreply@localhost
MAIL_FROM_NAME=Askbot

# OAuth2 (optional, leave empty to hide the buttons)
OAUTH_GOOGLE_ID=
OAUTH_GOOGLE_SECRET=
OAUTH_GITHUB_ID=
OAUTH_GITHUB_SECRET=
OAUTH_DISCORD_ID=
OAUTH_DISCORD_SECRET=

# Anti spam (optional)
HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=
