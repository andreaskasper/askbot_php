{
    "name": "andreaskasper/askbot_php",
    "description": "A self-hosted question and answer community platform written in plain PHP.",
    "type": "project",
    "license": "LicenseRef-FastFood-Minimal-1.0",
    "authors": [
        { "name": "Andreas Kasper", "email": "andreas.kasper@goo1.de" }
    ],
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "erusev/parsedown": "^1.7",
        "ezyang/htmlpurifier": "^4.17",
        "phpmailer/phpmailer": "^6.9",
        "robthree/twofactorauth": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "classmap": ["html/app/code/classes/"]
    },
    "config": {
        "vendor-dir": "vendor",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --colors=always"
    }
}
